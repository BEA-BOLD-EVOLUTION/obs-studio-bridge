{
  "name": "obs-studio-mcp-bridge",
  "version": "1.5.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "description": "OBS Creator Assistant local companion and allowlisted OBS automation bridge.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "obs-websocket-js": "5.0.8",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}

